# ─────────────────────────────────────────────────────────────────────────────
# PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo como `.env` y ajusta los valores a tu entorno local.
# NUNCA subas el `.env` real al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Modelo LLM (Ollama) ──────────────────────────────────────────────────────
# Modelo principal para generación de SQL y síntesis de respuestas
OLLAMA_MODEL=llama3.1:8b

# Modelo de embeddings (también en Ollama, sin API key)
OLLAMA_EMBED_MODEL=nomic-embed-text

# URL base de Ollama (cambiar si corres Ollama en otro host/puerto)
OLLAMA_BASE_URL=http://localhost:11434

# ── Base de datos ────────────────────────────────────────────────────────────
# Ruta relativa a la BD SQLite generada por el algoritmo Robledo
DB_PATH=data/db/bibliometria.db

# ── Vector store (ChromaDB) ──────────────────────────────────────────────────
# Directorio donde se persiste el índice vectorial
CHROMA_DIR=chroma_db

# Nombre de la colección en ChromaDB
CHROMA_COLLECTION=bibliometric_abstracts

# ── Schema Linking (Capa 1) ──────────────────────────────────────────────────
# Número de tablas a seleccionar por MMR en el schema linker
SCHEMA_TOP_K=4

# Umbral mínimo de similitud coseno para incluir una tabla (0-1)
SCHEMA_SIMILARITY_THRESHOLD=0.3

# ── RAG (Capa 3) ─────────────────────────────────────────────────────────────
# Número de chunks a recuperar del vector store
RAG_TOP_K=5

# ── Agente (Capa 2) ──────────────────────────────────────────────────────────
# Máximo de intentos de auto-corrección SQL antes de rendirse
SQL_MAX_RETRIES=3

# Temperatura del LLM (0 = determinista, recomendado para SQL)
LLM_TEMPERATURE=0.0

# ── Streamlit (Capa 4) ───────────────────────────────────────────────────────
# Puerto de la interfaz web
STREAMLIT_PORT=8501
